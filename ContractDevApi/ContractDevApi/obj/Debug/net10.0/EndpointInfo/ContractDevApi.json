                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserAccount"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserAccount"
                }
              }
            }
          }
        }
