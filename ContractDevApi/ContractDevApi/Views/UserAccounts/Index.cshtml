@model IEnumerable<ContractDevApi.Models.UserAccount>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FirstName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LastName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Country)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PasswordHash)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Is2faEnabled)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EncryptedTOTPSecret)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RecoveryCodesHash)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FirstName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LastName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Country)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PasswordHash)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Is2faEnabled)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EncryptedTOTPSecret)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RecoveryCodesHash)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.UserAccountId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.UserAccountId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.UserAccountId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
